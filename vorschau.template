<!doctype html><html lang="de"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>/*TITEL*/</title><style>
*{box-sizing:border-box}body{margin:0;background:#f5f4eb;color:#153e32;font:15px/1.45 system-ui,sans-serif}main{margin:auto;max-width:1260px;padding:32px clamp(19px,5vw,74px) 70px}.over,.index,small,footer,.bar label{font:600 11px/1.5 ui-monospace,monospace;letter-spacing:.09em;text-transform:uppercase}header{border-top:3px solid #234e3b;border-bottom:1px solid #adb5a4;padding:14px 0 26px}.over,footer,.bar{display:flex;align-items:center;justify-content:space-between;gap:12px}.hero{display:flex;justify-content:space-between;align-items:center;gap:24px;margin-top:32px}h1{font:normal clamp(54px,8vw,104px)/.96 Georgia,serif;letter-spacing:-.065em;margin:5px 0 16px}p{margin:0;color:#4f6455}.sample{display:flex;align-items:center;justify-content:center;gap:3px;background:#dce8cf;padding:12px 18px;border-radius:16px;transform:rotate(-3deg)}.sample img{width:clamp(42px,6vw,86px);height:auto}.bar{justify-content:flex-start;flex-wrap:wrap;margin:22px 0 30px}.bar button{border:1px solid #a5b5a4;background:transparent;border-radius:30px;padding:7px 14px;color:inherit;font:inherit;cursor:pointer}.bar button[aria-pressed=true]{background:#204d3a;color:#fff;border-color:#204d3a}h2{font:normal 30px Georgia,serif;margin:0;letter-spacing:-.03em}.sectionhead{display:flex;align-items:center;gap:13px;margin:34px 0 14px}.index{background:#dce7d0;padding:4px 8px;border-radius:5px}.total{margin-left:auto;color:#536855}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(148px,1fr));gap:9px}.tile{background:#fffef8;border:1px solid #d4d9ca;border-radius:10px;overflow:hidden}.well{height:92px;display:flex;align-items:center;justify-content:center;gap:7px}.well img{width:38px;height:38px}.well img:only-child{width:53px;height:53px}.well .white{background:#284438;border-radius:7px;padding:3px}.caption{border-top:1px solid #e4e7db;padding:8px 10px;font-size:13px;font-weight:580}footer{border-top:1px solid #aab7a3;margin-top:42px;padding-top:13px}.total{font-size:10px}.banner{margin:22px 0 0;border-left:4px solid #b4462f;background:#f7e6df;padding:12px 16px;border-radius:0 10px 10px 0;font-size:14px;line-height:1.5}.banner:empty{display:none;margin:0}.banner b{letter-spacing:.04em;text-transform:uppercase;font:700 11px/1.5 ui-monospace,monospace}@media(max-width:600px){.sample img:not(:first-child){display:none}.sample{padding:10px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.well{gap:3px}.well img{width:32px;height:32px}.bar{gap:5px}.bar button{font-size:13px}.total{display:none}} </style>
<main><header><div class="over"><span>BW &nbsp; / &nbsp; Digitales Schreibatelier</span><span>/*SERIE*/</span></div><div class="hero"><div><h1>/*UEBERSCHRIFT*/</h1><p>/*UNTERTITEL*/</p></div><div class="sample" id="sample" aria-hidden="true"></div></div></header><div class="banner" id="banner">/*BANNER*/</div><div class="bar" id="bar"><label>Ansicht</label></div><div id="catalog"></div><footer><span>/*FOOTER*/</span><span>Blattwerk · /*KURZ*/</span></footer></main>
<script>const data=/*ICON_DATA*/,prefix='/*GRUPPE*/',VN={farbe:'Farbe',gruen:'Grün',rot:'Rot',schwarz:'Schwarz',weiss:'Weiß'};const vs=[...new Set(data.flatMap(g=>g.items.flatMap(o=>Object.keys(o.icons))))];const getImg=(src,v)=>`<img src="${src}" title="${VN[v]||v}" alt="${v}" class="${v==='weiss'?'white':''}">`;sample.innerHTML=data.flatMap(g=>g.items).filter(o=>o.icons[vs[0]]).slice(0,3).map(o=>getImg(o.icons[vs[0]],vs[0])).join('');bar.insertAdjacentHTML('beforeend',['alle',...vs].map(v=>`<button data-v="${v}">${v==='alle'?'Alle':(VN[v]||v)}</button>`).join(''));function draw(v){catalog.innerHTML=data.map((g,i)=>{let cells=g.items.map(o=>{let chosen=Object.entries(o.icons).filter(([k])=>v==='alle'||k===v);return chosen.length?`<div class="tile"><div class="well">${chosen.map(([k,s])=>getImg(s,k)).join('')}</div><div class="caption">${o.label}</div></div>`:''}).join('');return cells?`<section><div class="sectionhead"><span class="index">${prefix}${String(i+1).padStart(2,'0')}</span><h2>${g.name}</h2><small class="total">${g.items.length} Motive</small></div><div class="grid">${cells}</div></section>`:''}).join('');document.querySelectorAll('#bar button').forEach(b=>b.setAttribute('aria-pressed',b.dataset.v===v))}document.querySelectorAll('#bar button').forEach(b=>b.onclick=()=>draw(b.dataset.v));draw('alle')</script></html>
